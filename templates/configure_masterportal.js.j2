const fs = require("fs");

const [configPath, servicesPath] = process.argv.slice(2);
if (!configPath || !servicesPath || process.argv.length !== 4) {
  throw new Error("Usage: node configure-masterportal.cjs /operator/config.json /operator/services.json");
}
if (require("path").resolve(configPath) === require("path").resolve(servicesPath)) {
  throw new Error("config.json and services.json must be different files.");
}
const layerId = {{ inv_addons.baikor_r.publication.layer_id | to_json }};
const layerTitle = {{ inv_addons.baikor_r.publication.layer_title | to_json }};
const workspace = {{ inv_addons.baikor_r.publication.workspace | to_json }};
const featureType = {{ inv_addons.baikor_r.publication.feature_type | to_json }};
const searchFeatureType = {{ inv_addons.baikor_r.publication.search_feature_type | to_json }};
const managedLayerName = workspace + ":" + featureType;
const services = JSON.parse(fs.readFileSync(servicesPath, "utf8"));
const existingService = services.find((entry) => entry.id === layerId);
if (existingService && existingService.layers !== managedLayerName) {
  throw new Error("The configured Baikor layer ID belongs to another layer. Choose a unique layer_id.");
}
const managedLayerIds = new Set([layerId]);

const config = JSON.parse(fs.readFileSync(configPath, "utf8"));
const subjectLayers = config.layerConfig.subjectlayer.elements;
let folder = subjectLayers.find((entry) => entry.name === "Baustellen");
if (!folder) {
  folder = { name: "Baustellen", type: "folder", elements: [] };
  subjectLayers.push(folder);
}
folder.elements = (folder.elements || []).filter((entry) => !managedLayerIds.has(entry.id));
folder.elements.push({ id: layerId, visibility: true });

config.portalConfig.mainMenu = config.portalConfig.mainMenu || {};
config.portalConfig.mainMenu.searchBar = config.portalConfig.mainMenu.searchBar || {};
config.portalConfig.mainMenu.searchBar.searchInterfaces =
  config.portalConfig.mainMenu.searchBar.searchInterfaces || [];
const searchInterfaces = config.portalConfig.mainMenu.searchBar.searchInterfaces;
let constructionSiteSearch = searchInterfaces.find(
  (entry) => entry.type && entry.type.toLowerCase() === "specialwfs"
);
if (!constructionSiteSearch) {
  constructionSiteSearch = {
    type: "specialWfs",
    definitions: [],
    resultEvents: { onClick: ["setMarker", "zoomToResult"], onHover: ["setMarker"] }
  };
  searchInterfaces.push(constructionSiteSearch);
}
constructionSiteSearch.definitions = (constructionSiteSearch.definitions || []).filter(
  (definition) => definition.typeName !== workspace + ":" + searchFeatureType
);
constructionSiteSearch.definitions.push({
  url: "https://geoportal.{{ inv_gd.domain }}/geoserver/" + workspace + "/wfs",
  typeName: workspace + ":" + searchFeatureType,
  propertyNames: [workspace + ":title"],
  geometryName: workspace + ":geometry",
  name: "Baustellen",
  icon: "bi-cone-striped",
  maxFeatures: 20,
  namespaces: "xmlns:" + workspace + "='" + {{ baikor_geoserver_namespace.json.namespace.uri | to_json }} + "'"
});

const filteredServices = services.filter((entry) => !managedLayerIds.has(entry.id));
filteredServices.push({
  id: layerId,
  name: layerTitle,
  url: "https://geoportal.{{ inv_gd.domain }}/geoserver/" + workspace + "/wms",
  typ: "WMS",
  layers: workspace + ":" + featureType,
  format: "image/png",
  version: "1.3.0",
  singleTile: false,
  transparent: true,
  transparency: 0,
  minScale: "0",
  maxScale: "2500000",
  gfiAttributes: {
    title: "Bezeichnung",
    area_name: "Bereich",
    status_label: "Status",
    planned_start: {
      name: "Beginn",
      condition: "contains",
      type: "date",
      format: "DD.MM.YYYY"
    },
    planned_end: {
      name: "Ende",
      condition: "contains",
      type: "date",
      format: "DD.MM.YYYY"
    },
    area_size_sqm: {
      name: "Fläche",
      condition: "contains",
      type: "number",
      suffix: " m²"
    },
    diversion: "Umleitung",
    communications: "Kommunikation",
    updated_at: {
      name: "Aktualisiert",
      condition: "contains",
      type: "date",
      format: "DD.MM.YYYY, HH:mm"
    }
  },
  gfiTheme: "default",
  gfiComplex: "false",
  featureCount: 20,
  legendURL: "",
  cache: false,
  datasets: false,
  roles: [workspace]
});
fs.writeFileSync(servicesPath, JSON.stringify(filteredServices));
fs.writeFileSync(configPath, JSON.stringify(config));
